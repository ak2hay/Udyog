# Prefer Neon pooled URL (host contains -pooler) for Vercel/serverless.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Must match the URL you open in the browser (prefer http://localhost:3000).
# Auth also trusts localhost:3000–3020 for local port auto-bump.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated emails that can access /superadmin (bootstrap).
# Sign up with this email first, then open /superadmin (or re-run pnpm db:seed).
SUPER_ADMIN_EMAILS=you@example.com

# AES key material for encrypting SMTP/Razorpay secrets in platform_settings.
# Falls back to BETTER_AUTH_SECRET if unset.
PLATFORM_SECRETS_KEY=replace-with-another-long-random-secret

# Optional fallbacks if not set in Super Admin → Settings → Razorpay
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
